local coinCounter = 0
local lastTarget = nil

spawn(function()
    print("✅ AUTO FARM + CRATE + SUMMER BOX '26 ACTIVE")
    
    while SETTINGS.Enabled do
        pcall(function()
            if not isRoundActive then wait(1) return end
            local hrp = getHRP(); if not hrp then wait(1) return end
            
            if hrp.Position.Y < -50 then
                if currentTween then currentTween:Cancel(); currentTween = nil end
                isMoving = false
                hrp.CFrame = CFrame.new(hrp.Position.X, 50, hrp.Position.Z)
                wait(2); return
            end
            
            local bag = getBagCoins()
            if bag >= SETTINGS.MaxBagCoins then
                if currentTween then currentTween:Cancel(); currentTween = nil end
                isMoving = false
                if SETTINGS.AutoRespawn and not isRespawning then forceRespawn() end
                wait(SETTINGS.SpawnWaitTime); return
            end
            
            local map
            for _, o in ipairs(workspace:GetChildren()) do if o:FindFirstChild("CoinContainer") then map = o; break end end
