-- 🔍 ФИНАЛЬНЫЙ ТЕСТ: ОПРЕДЕЛЕНИЕ ID SUMMER BOX '26
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")
local LP = Players.LocalPlayer

print("🔍 [FINAL TEST] Определение ID Summer Box '26")
print("📋 ВАЖНО: Открой Summer Box ВРУЧНУЮ после запуска скрипта!")
print("")

-- Ждём полной загрузки
print("⏳ Жду загрузку игры (10 сек)...")
wait(10)

local Shop = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Shop")
if not Shop then
    print("❌ Shop не найден! Перезапусти скрипт через 10 сек после входа")
    return
end

local OpenCrate = Shop:FindFirstChild("OpenCrate")
if not OpenCrate then
    print("❌ OpenCrate не найден!")
    return
end

print("✅ OpenCrate найден: " .. OpenCrate.ClassName)
print("")

-- Перехват вызовов
local detectedId = nil
local detectedArgs = {}

if hookfunction then
    print("🎣 Перехват активен. Открой Summer Box вручную!")
    
    local oldInvoke = OpenCrate.InvokeServer
    hookfunction(OpenCrate.InvokeServer, function(self, ...)
        local args = {...}
        print("📤 [ПЕРЕХВАТ] OpenCrate вызван!")
        
        for i, v in ipairs(args) do
            print("   arg" .. i .. ": " .. tostring(v) .. " (" .. typeof(v) .. ")")
            detectedArgs[i] = v
        end
        
        -- Ищем ID
        for _, v in ipairs(args) do
            local s = tostring(v)
            if s:find("Summer") or s:find("summer") or s:find("26") or s:find("Box") then
                if not detectedId then
                    detectedId = v
                    print("🎯🎯 ID НАЙДЕН: " .. tostring(v) .. " 🎯🎯")
                end
            end
        end
        
        return oldInvoke(self, ...)
    end)
else
    print("⚠️ hookfunction недоступен")
end

print("")
print("👉 ТЕПЕРЬ ОТКРОЙ SUMMER BOX ВРУЧНУЮ В МАГАЗИНЕ")
print("   Скрипт перехватит вызов и покажет правильный ID")
print("")

-- Ждём 60 секунд для ручного открытия
local startTime = tick()
while tick() - startTime < 60 do
    if detectedId then
        break
    end
    wait(1)
end

if detectedId then
    print("")
    print("✅✅✅ РЕЗУЛЬТАТ ✅✅✅")
    print("🎯 ID бокса: " .. tostring(detectedId))
    print("📦 Все аргументы:")
    for i, v in ipairs(detectedArgs) do
        print("   " .. i .. ": " .. tostring(v) .. " (" .. typeof(v) .. ")")
    end
    print("")
    print("📝 Используй эти данные в основном скрипте:")
    print('   OpenCrate:InvokeServer("' .. tostring(detectedId) .. '", "MysteryBox", "Shells")')
else
    print("")
    print("❌ ID не определён за 60 секунд")
    print("💡 Попробуй:")
    print("   1. Убедись что магазин открыт")
    print("   2. Кликни на Summer Box '26")
    print("   3. Даже если нет Shells — кликни, вызов всё равно будет")
end
