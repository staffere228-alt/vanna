-- Ждём загрузки Shop
local Shop = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Shop")
local OpenCrate = Shop:WaitForChild("OpenCrate")

print("✅ [TEST] OpenCrate найден: " .. OpenCrate.ClassName)

-- Способ 1: Перехват через hookfunction (работает в большинстве эксплойтов)
if hookfunction then
    print("🎣 [TEST] Используем hookfunction...")
    
    local oldInvoke = OpenCrate.InvokeServer
    hookfunction(OpenCrate.InvokeServer, function(self, ...)
        local args = {...}
        print("📤 [HOOK] OpenCrate.InvokeServer вызван!")
        for i, v in ipairs(args) do
            print("   arg" .. i .. ": " .. tostring(v) .. " (" .. typeof(v) .. ")")
        end
        
        -- Если это Shells или Summer — запоминаем
        for _, v in ipairs(args) do
            local s = tostring(v):lower()
            if s:find("summer") or s:find("shell") or s:find("26") then
                print("🎯 [HOOK] ВОЗМОЖНЫЙ ID: " .. tostring(v))
            end
        end
        
        return oldInvoke(self, ...)
    end)
else
    print("⚠️ [TEST] hookfunction недоступен, используем backup метод...")
end

-- Способ 2: Мониторинг через RunService (backup)
local lastCheck = tick()
local detectedIds = {}

game:GetService("RunService").Heartbeat:Connect(function()
    if tick() - lastCheck > 0.1 then
        lastCheck = tick()
        
        -- Ищем в PlayerGui любые кнопки/текст с Summer
        local pg = LP:FindFirstChild("PlayerGui")
        if pg then
            for _, obj in ipairs(pg:GetDescendants()) do
                if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                    local name = obj.Name:lower()
                    if name:find("summer") or name:find("box") or name:find("crate") then
                        if not detectedIds[obj.Name] then
                            detectedIds[obj.Name] = true
                            print("🔘 [UI] Найдена кнопка: " .. obj:GetFullName())
                            print("   Name: " .. obj.Name)
                            
                            -- Пробуем кликнуть и посмотреть что будет
                            if obj.Visible and obj.AbsoluteSize.X > 10 then
                                print("   🖱️ Кнопка видима, размер: " .. tostring(obj.AbsoluteSize))
                            end
                        end
                    end
                end
                
                -- Ищем TextLabel с ID
                if obj:IsA("TextLabel") then
                    local text = obj.Text or ""
                    if text:find("SummerBox") or text:find("Summer_") or text:find("Box26") then
                        print("📝 [UI] Текст с ID: '" .. text .. "' в " .. obj:GetFullName())
                    end
                end
            end
        end
    end
end)

