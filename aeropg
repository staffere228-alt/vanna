local function setupRoundDetection()
    local rs = ReplicatedStorage:FindFirstChild("Remotes")
    local gp = rs and rs:FindFirstChild("Gameplay")
    local rStart = gp and gp:FindFirstChild("RoundStart")
    if rStart and rStart:IsA("RemoteEvent") then
        rStart.OnClientEvent:Connect(function() isRoundActive = true; enableNoClip() end)
    else
        delay(3, function() if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then isRoundActive = true; enableNoClip() end end)
    end
end

LocalPlayer.CharacterAdded:Connect(function(c)
    isRoundActive = false; disableNoClip(); wait(1)
    local h = c:FindFirstChildOfClass("Humanoid")
    if h then h.Died:Connect(function() isRoundActive = false; disableNoClip() end) end
end)

-- ================= 🛠️ ВСПОМОГАТЕЛЬНЫЕ =================
local function getHRP() local c = LocalPlayer.Character; return c and c:FindFirstChild("HumanoidRootPart") end

local function getBagCoins()
    local pg = LocalPlayer:FindFirstChild("PlayerGui"); if not pg then return 0 end
    local function sf(p,n) return p and p:FindFirstChild(n) end
    local o = sf(sf(sf(sf(sf(sf(sf(sf(pg,"MainGUI"),"Lobby"),"Dock"),"CoinBags"),"Container"),"Coin"),"CurrencyFrame"),"Icon")
    if o then o = o:FindFirstChild("Coins") end
    if not o then return 0 end
    return tonumber(string.match(o.Text or "", "%d+") or "0") or 0
end

-- 🐚 SHELLS — ПРАВИЛЬНЫЙ ПУТЬ ИЗ ДИАГНОСТИКИ
local function getShells()
    local pg = LocalPlayer:FindFirstChild("PlayerGui"); if not pg then return 0 end
    local function sf(p,n) return p and p:FindFirstChild(n) end
    
    -- Путь из логов: CrossPlatform.Summer2026.Container.Main...
    local paths = {
        {"CrossPlatform", "Summer2026", "Container", "Main", "TopBar", "Shells", "Amount"},
        {"CrossPlatform", "Summer2026", "Container", "Main", "Currency", "Shells", "Value"},
        {"CrossPlatform", "Summer2026", "Container", "Main", "Header", "Shells"},
        {"MainGUI", "Lobby", "TopBar", "Shells", "Amount"},
        {"MainGUI", "Shop", "SummerBox", "Currency", "Amount"},
    }
    
    for _, path in ipairs(paths) do
        local obj = pg
        for _, name in ipairs(path) do obj = sf(obj, name); if not obj then break end end
        if obj and (obj:IsA("TextLabel") or obj:IsA("TextButton")) then
            local num = tonumber(string.match(obj.Text or "", "%d+") or "0")
            if num and num >= 0 then return num end
        end
    end
    
    -- Fallback: ищем любой TextLabel с "Shells" в Summer2026
    local summer = sf(pg, "CrossPlatform") and pg.CrossPlatform:FindFirstChild("Summer2026")
    if summer then
        for _, d in ipairs(summer:GetDescendants()) do
            if d:IsA("TextLabel") and d.Text:lower():find("shell") then
                local num = tonumber(string.match(d.Text, "%d+") or "0")
                if num and num > 0 then return num end
            end
        end
    end
    
    return 0
end

-- ================= 💀 РЕСПАВН =================
local function forceRespawn()
    if isRespawning then return end
    isRespawning = true
    local char = LocalPlayer.Character; if not char then isRespawning = false; return end
    local hum = char:FindFirstChildOfClass("Humanoid"); if not hum then isRespawning = false; return end
    if currentTween then pcall(function() currentTween:Cancel() end); currentTween = nil end
    isMoving = false
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Dead); hum.Health = 0 end)
    wait(SETTINGS.SpawnWaitTime)
    local nc = LocalPlayer.Character
    if nc and nc ~= char then
        local hrp = nc:WaitForChild("HumanoidRootPart", 5)
        if hrp then enableNoClip() end
    else
        pcall(function() char:Destroy() end); wait(2)
        local rc = LocalPlayer.Character
        if rc then local rh = rc:WaitForChild("HumanoidRootPart", 5); if rh then enableNoClip() end end
    end
    isRespawning = false
end

-- ================= 🪙 МОНЕТЫ =================
local function isCollected(c) local n=tick(); for _,d in ipairs(collectedCoins) do if d.coin==c and n<d.time+IGNORE_DUR then return true end end; return false end
local function markCollected(c) table.insert(collectedCoins,{coin=c,time=tick()}); if #collectedCoins>MAX_IGNORED then table.remove(collectedCoins,1) end end
local function getNearestCoin(map, hrp)
    if not map or not hrp then return nil, math.huge end
    local cont = map:FindFirstChild("CoinContainer"); if not cont then return nil, math.huge end
    local t, md = nil, math.huge
    for _, p in next, cont:GetChildren() do
        if p:IsA("BasePart") and p.Name:lower():find("coin") and not isCollected(p) then
            local d = (p.Position-hrp.Position).Magnitude
            if d < md then md = d; t = p end
        end
    end
    return t, md
end

local function tweenToTarget(hrp, pos)
    if currentTween then pcall(function() currentTween:Cancel() end) end
    local dist = (pos-hrp.Position).Magnitude
    local ti = TweenInfo.new(math.max(dist/SETTINGS.MoveSpeed, 0.1), Enum.EasingStyle.Linear)
    currentTween = TweenService:Create(hrp, ti, {CFrame = CFrame.new(pos)})
    isMoving = true
    currentTween.Completed:Connect(function() isMoving = false; currentTween = nil end)
    currentTween:Play()
end

-- ================= 📦 КЕЙСЫ =================
local Shop = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Shop")
local OpenCrate = Shop:WaitForChild("OpenCrate")
local BoxController = Shop:WaitForChild("BoxController")

local boxes = {"KnifeBox1","KnifeBox2","KnifeBox3","KnifeBox4","KnifeBox5","GunBox1","GunBox3"}
local currencies = {"Coins","Gems","Key"}

local function openRandomCrate()
    local id = boxes[math.random(1,#boxes)]
    for _, cur in ipairs(currencies) do
        local ok, res = pcall(function() return OpenCrate:InvokeServer(id, "MysteryBox", cur) end)
        if ok and res then
            pcall(function() BoxController:Fire({{MysteryBoxId=id, RewardedItemId=res}}) end)
            return true
        end
    end
    return false
end

spawn(function()
    while SETTINGS.Enabled do
        if openRandomCrate() then wait(2.5) else wait(5) end
    end
end)

-- ================= 🐚 SUMMER BOX '26 =================
local detectedSummerId = nil

-- Авто-детект ID при ручном открытии
pcall(function()
    local oldInvoke = OpenCrate.InvokeServer
    OpenCrate.InvokeServer = function(self, boxId, boxType, currency, ...)
        if currency == "Shells" or tostring(boxId):lower():find("summer") then
            detectedSummerId = boxId
            print("🎯 [SUMMER] Обнаружен ID бокса: " .. tostring(boxId))
        end
        return oldInvoke(self, boxId, boxType, currency, ...)
    end
end)

local function openSummerBox()
    local boxId = detectedSummerId or "SummerBox26"
    local shells = getShells()
    
    if shells < SETTINGS.SummerBoxCost then
        return false, shells
    end
    
    local ok, result = pcall(function()
        return OpenCrate:InvokeServer(boxId, "MysteryBox", "Shells")
    end)
    
    if ok and result then
        pcall(function() BoxController:Fire({{MysteryBoxId=boxId, RewardedItemId=result}}) end)
        print("🐚 [SUMMER] ✅ Открыт " .. boxId .. "! Выпало:", result)
        return true, shells - SETTINGS.SummerBoxCost
    end
    
    return false, shells
end

spawn(function()
    if not SETTINGS.SummerBoxEnabled then return end
    wait(5)
    
    print("🐚 [SUMMER] Auto Summer Box '26 запущен")
    print("   💡 Совет: открой 1 Summer Box вручную, чтобы скрипт запомнил ID")
    
    local opened = 0
    local failed = 0
    local lastShells = -1
    
    while SETTINGS.Enabled do
        local success, shells = openSummerBox()
        
        if success then
            opened = opened + 1
            print("🐚 [SUMMER] Открыто: " .. opened .. " | Shells: ~" .. tostring(shells))
            wait(SETTINGS.SummerBoxDelay)
        else
            failed = failed + 1
            if shells ~= lastShells then
                lastShells = shells
                print("🐚 [SUMMER] Баланс: " .. tostring(shells) .. "/" .. SETTINGS.SummerBoxCost)
            end
            wait(5)
        end
    end
end)

