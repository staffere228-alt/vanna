local SETTINGS = {
    Enabled = true,
    ClickDelay = 2.5,
    ShellsNeeded = 120,
}

-- Клик по кнопке
local function clickButton(button)
    if not button or not button.Visible then return false end
    if button.AbsoluteSize.X < 10 then return false end
    
    local pos = button.AbsolutePosition + button.AbsoluteSize / 2
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
    end)
    return true
end

-- Получить баланс Shells
local function getShells()
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return 0 end
    
    -- Путь из логов: CrossPlatform.Summer2026
    local cp = pg:FindFirstChild("CrossPlatform")
    if cp then
        local s26 = cp:FindFirstChild("Summer2026")
        if s26 then
            for _, d in ipairs(s26:GetDescendants()) do
                if d:IsA("TextLabel") then
                    local t = d.Text or ""
                    if t:lower():find("shell") or d.Name:lower():find("shell") then
                        local n = tonumber(string.match(t, "%d+") or "0")
                        if n and n > 0 then return n end
                    end
                end
            end
        end
    end
    
    -- Fallback: ищем любой TextLabel с числом рядом со словом Shells
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("TextLabel") and d.Visible then
            local t = d.Text or ""
            if t:lower():find("shell") then
                local n = tonumber(string.match(t, "%d+") or "0")
                if n and n > 0 then return n end
            end
        end
    end
    
    return 0
end

-- Найти кнопку Summer Box
local function findSummerBox()
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return nil end
    
    local mg = pg:FindFirstChild("MainGUI")
    if not mg then return nil end
    
    -- Путь из логов: MainGUI.Game.Crafting.Inventory.Salvage...
    local game = mg:FindFirstChild("Game")
    if not game then return nil end
    
    local crafting = game:FindFirstChild("Crafting")
    if not crafting then return nil end
    
    local inv = crafting:FindFirstChild("Inventory")
    if not inv then return nil end
    
    local salv = inv:FindFirstChild("Salvage")
    if not salv then return nil end
    
    local sf = salv:FindFirstChild("ScrollFrame")
    if not sf then return nil end
    
    local cont = sf:FindFirstChild("Container")
    if not cont then return nil end
    
    -- Ищем Bubbles_K_2026 или похожее
    for _, child in ipairs(cont:GetChildren()) do
        local name = child.Name:lower()
        if name:find("2026") or name:find("summer") or name:find("bubble") then
            local btn = child:FindFirstChild("Button") or child:FindFirstChildOfClass("TextButton") or child:FindFirstChildOfClass("ImageButton")
            if btn and btn.Visible then
                return btn
            end
            -- Или сам контейнер кликабельный
            if child:IsA("TextButton") or child:IsA("ImageButton") then
                return child
            end
        end
    end
    
    return nil
end

-- Открыть магазин если закрыт
local function openShopIfNeeded()
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return end
    
    local mg = pg:FindFirstChild("MainGUI")
    if not mg then return end
    
    local game = mg:FindFirstChild("Game")
    if not game then return end
    
    local dock = game:FindFirstChild("Dock")
    if not dock then return end
    
    local shop = dock:FindFirstChild("Shop")
    if shop and shop.Visible then
        return true -- магазин уже открыт
    end
    
    -- Кликаем кнопку магазина
    if shop then
        clickButton(shop)
        task.wait(1)
        return true
    end
    
    return false
end

-- Главный цикл
spawn(function()
    print("✅ [FINAL] Запущен")
    local clicks = 0
    local lastShells = -1
    
    while SETTINGS.Enabled do
        local shells = getShells()
        
        -- Показываем баланс раз в 10 сек
        if shells ~= lastShells then
            lastShells = shells
            print("💰 Shells: " .. shells .. "/" .. SETTINGS.ShellsNeeded)
        end
        
        if shells >= SETTINGS.ShellsNeeded then
            -- Открываем магазин если нужно
            openShopIfNeeded()
            task.wait(0.5)
            
            -- Ищем кнопку Summer Box
            local btn = findSummerBox()
            
            if btn then
                print("🖱️ [CLICK] Summer Box найден! Кликаю...")
                clickButton(btn)
                clicks = clicks + 1
                print("   ✅ Открыто: " .. clicks)
                task.wait(SETTINGS.ClickDelay)
            else
                print("⚠️ Кнопка Summer Box не найдена")
                print("   Убедись что:")
                print("   1. Ты в лобби (не в раунде)")
                print("   2. Магазин открыт")
                print("   3. Вкладка Salvage/Crafting активна")
                task.wait(5)
            end
        else
            task.wait(3)
        end
    end
end)

