local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local LP = Players.LocalPlayer

print("🎯 [ULTIMATE TEST] Перехват ВСЕХ remotes")
print("📋 Инструкция:")
print("   1. Запусти скрипт")
print("   2. Открой магазин")
print("   3. Кликни на Summer Box '26")
print("   4. Смотри какой remote вызвался")
print("")

wait(5)

-- Перехватываем ВСЕ RemoteEvent и RemoteFunction
local hooked = 0

for _, remote in ipairs(ReplicatedStorage:GetDescendants()) do
    if remote:IsA("RemoteEvent") then
        pcall(function()
            local oldFire = remote.FireServer
            remote.FireServer = function(self, ...)
                local args = {...}
                print("📤 [RemoteEvent] " .. remote:GetFullName())
                for i, v in ipairs(args) do
                    print("   arg" .. i .. ": " .. tostring(v) .. " (" .. typeof(v) .. ")")
                end
                return oldFire(self, ...)
            end
            hooked = hooked + 1
        end)
    elseif remote:IsA("RemoteFunction") then
        pcall(function()
            local oldInvoke = remote.InvokeServer
            remote.InvokeServer = function(self, ...)
                local args = {...}
                print("📤 [RemoteFunction] " .. remote:GetFullName())
                for i, v in ipairs(args) do
                    print("   arg" .. i .. ": " .. tostring(v) .. " (" .. typeof(v) .. ")")
                end
                return oldInvoke(self, ...)
            end
            hooked = hooked + 1
        end)
    end
end

print("✅ Перехвачено remotes: " .. hooked)
print("")
print("👉 ТЕПЕРЬ ОТКРОЙ МАГАЗИН И КЛИКНИ НА SUMMER BOX '26")
